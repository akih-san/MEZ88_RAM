   98/258F :                            	; This is a BIOS for the CPM.SYS file.
   99/258F :                            	; Setup all interrupt vectors in low
  100/258F :                            	; memory to address trap
  101/258F :                            
  102/258F : 1E                         	push	ds		;save the DS register
  103/2590 : C6 06 22 27 00             	mov	[IOBYTE],0	;clear IOBYTE
  104/2595 : B8 00 00                   	mov	ax,0
  105/2598 : 8E D8                      	mov	ds,ax
  106/259A : 8E C0                      	mov	es,ax 		;set ES and DS to zero
  107/259C :                            
  108/259C : =>FALSE                    	if UNIMON = 0
  109/259C :                            	;setup interrupt 0 to address trap routine
  110/259C :                            	mov	[int0_offset],int_trap
  111/259C :                            	mov	[int0_segment],CS
  112/259C :                            	mov	di,4
  113/259C :                            	mov	si,0		;then propagate
  114/259C :                            	mov	cx,510		;trap vector to
  115/259C :                            
  116/259C :                            ;	rep movs ax,ax	;all 256 interrupts
  117/259C :                            	rep movsw		;all 256 interrupts
  118/259C : [108]                      	endif
  119/259C :                            
  120/259C :                            	;BDOS offset to proper interrupt
  121/259C : C7 06 80 03 06 0B          	mov	[bdos_offset],bdos_ofst
  122/25A2 : 8C 0E 82 03                	mov	[bdos_segment],CS
  123/25A6 : 1F                         	pop	ds		;restore the DS register
  124/25A7 :                            
  125/25A7 :                            ;	(additional CP/M-86 initialization)
  126/25A7 :                            ;|                                           |
  127/25A7 :                            ;---------------------------------------------
  128/25A7 :                            
  129/25A7 : BB 23 27                   	mov	bx,signon
  130/25AA : E8 6E 00                   	call	pmsg		;print signon message
  131/25AD : B1 00                      	mov	cl,0		;default to dr A: on coldstart
  132/25AF : E9 4E DA                   	jmp	ccp		;jump to cold start entry of CCP
  133/25B2 :                            
  134/25B2 : E9 51 DA                   WBOOT:	jmp	ccp+6		;direct entry to CCP at command level
