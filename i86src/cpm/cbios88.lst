  209/25EA :                            
  210/25EA : 26 A0 07 00                	mov	al, es:[CBI_CHR]		; get char or status
  211/25EE : 22 C0                      	and	al, al
  212/25F0 : 07                         	pop	es
  213/25F1 : C3                         	ret
  214/25F2 :                            
  215/25F2 :                            CONOUT:
