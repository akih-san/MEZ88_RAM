  412/26EB :                            ;*********************************************
  413/26EB :                            ;*                                           *
  414/26EB :                            ;*  All disk I/O parameters are setup:       *
  415/26EB :                            ;*     DISK     is disk number      (SELDSK) *
  416/26EB :                            ;*     TRK      is track number     (SETTRK) *
  417/26EB :                            ;*     SECT     is sector number    (SETSEC) *
  418/26EB :                            ;*     DMA_ADR  is the DMA offset   (SETDMA) *
  419/26EB :                            ;*     DMA_SEG  is the DMA segment  (SETDMAB)*
  420/26EB :                            ;*  READ reads the selected sector to the DMA*
  421/26EB :                            ;*  address, and WRITE writes the data from  *
  422/26EB :                            ;*  the DMA address to the selected sector   *
  423/26EB :                            ;*  (return 00 if successful,  01 if perm err)*
  424/26EB :                            ;*                                           *
