   53/2500 :                            
   54/2500 : E9 80 00                   	jmp	INIT		;Enter from BOOT ROM or LOADER
   55/2503 : E9 AC 00                   	jmp	WBOOT		;Arrive here from BDOS call 0  
   56/2506 : E9 B8 00                   	jmp	CONST		;return console keyboard status
   57/2509 : E9 C4 00                   	jmp	CONIN		;return console keyboard char
   58/250C : E9 E3 00                   	jmp	CONOUT  	;write char to console device
   59/250F : E9 F4 00                   	jmp	LISTOUT		;write character to list device
   60/2512 : E9 F7 00                   	jmp	PUNCH		;write character to punch device
   61/2515 : E9 F7 00                   	jmp	READER  	;return char from reader device 
   62/2518 : E9 80 01                   	jmp	HOME		;move to trk 00 on cur sel drive
   63/251B : E9 4D 01                   	jmp	SELDSK  	;select disk for next rd/write
   64/251E : E9 7E 01                   	jmp	SETTRK  	;set track for next rd/write
   65/2521 : E9 88 01                   	jmp	SETSEC  	;set sector for next rd/write
   66/2524 : E9 A4 01                   	jmp	SETDMA  	;set offset for user buff (DMA)
   67/2527 : E9 C1 01                   	jmp	READ		;read a 128 byte sector
   68/252A : E9 E6 01                   	jmp	WRITE		;write a 128 byte sector
   69/252D : E9 D9 00                   	jmp	LISTST  	;return list status 
   70/2530 : E9 87 01                   	jmp	SECTRAN 	;xlate logical->physical sector 
