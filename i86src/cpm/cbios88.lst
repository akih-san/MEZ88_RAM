  150/25C1 :                            ;*********************************************
  151/25C1 :                            
  152/25C1 :                            ;  ---- request command to PIC
  153/25C1 :                            ; UREQ_COM = 1 ; CONIN  : return char in UNI_CHR
  154/25C1 :                            ;          = 2 ; CONOUT : UNI_CHR = output char
  155/25C1 :                            ;          = 3 ; CONST  : return status in UNI_CHR
  156/25C1 :                            ;                       : ( 0: no key, 1 : key exist )
  157/25C1 :                            ;          = 4 ; STROUT : string address = (PTRSAV, PTRSAV_SEG)
  158/25C1 :                            ;          = 5 ; DISK READ
  159/25C1 :                            ;          = 6 ; DISK WRITE
  160/25C1 :                            ;          = 0 ; request is done( return this flag from PIC )
  161/25C1 :                            ;                return status is in UNI_CHR;
  162/25C1 :                            ;
  163/25C1 : =1H                        REQ_CONIN	equ	1
  164/25C1 : =2H                        REQ_CONOUT	equ	2
  165/25C1 : =3H                        REQ_CONST	equ	3
  166/25C1 : =4H                        REQ_STROUT	equ	4
  167/25C1 : =5H                        REQ_DREAD	equ	5
  168/25C1 : =6H                        REQ_DWRITE	equ	6
  169/25C1 : =0F000H                    DUMMY_PORT	equ	0f000h
  170/25C1 :                            
  171/25C1 :                            ; ------------------ Request Command 
  172/25C1 : =0H                        UREQ_COM	equ	0	; location 00	:CONIN/CONOUT request command
  173/25C1 :                            ; ------------------ CONSOLE I/O
  174/25C1 : =1H                        UNI_CHR		equ	1	; location 01	:charcter (CONIN/CONOUT) or counts(STROUT) or CONST
  175/25C1 : =2H                        STR_OFF		equ	2	; location 02	:string offset
  176/25C1 : =4H                        STR_SEG		equ	4	; location 04	:string segment
  177/25C1 :                            ; ------------------ CBIOS Command
  178/25C1 : =6H                        CREQ_COM	equ	6	; location 06	:CBIOS request command
  179/25C1 :                            ; ------------------ CBIOS CONSOLE I/O
  180/25C1 : =7H                        CBI_CHR		equ	7	; location 07	:charcter (CONIN/CONOUT) or counts(STROUT) or status
  181/25C1 : =8H                        disk_drive	equ	8	; location 06	:
  182/25C1 : =9H                        disk_track	equ	9	; location 07	:
  183/25C1 : =0AH                       disk_sector	equ	10	; location 08	:
  184/25C1 : =0CH                       data_dmal	equ	12	; location 0A	:
  185/25C1 : =0EH                       data_dmah	equ	14	; location 0C	:
  186/25C1 :                            
