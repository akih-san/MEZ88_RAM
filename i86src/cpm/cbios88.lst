  217/25F3 : 52                         	push	dx
  218/25F4 : BA 50 7F                   	mov	dx, UNI_SEG
  219/25F7 : 8E C2                      	mov	es, dx
  220/25F9 : 26 C6 06 06 00 02          	mov	byte ptr es:[CREQ_COM], REQ_CONOUT	; set CONOUT request
  221/25FF : 26 88 0E 07 00             	mov	es:[CBI_CHR], cl			; set char
  222/2604 : EB D7                      	jmp	CON_REQ
