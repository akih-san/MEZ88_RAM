  199/25D5 : 8E C2                      	mov	es, dx
  200/25D7 : 26 C6 06 06 00 01          	mov	byte ptr es:[CREQ_COM], REQ_CONIN	; set CONIN request
  201/25DD :                            CON_REQ:
  202/25DD : BA 00 F0                   	mov	dx, DUMMY_PORT
  203/25E0 : EC                         	in	al, dx				; invoke PIC F/W
  204/25E1 : 5A                         	pop	dx
  205/25E2 :                            wait_conin:
  206/25E2 : 26 A0 06 00                	mov	al, es:[CREQ_COM]
