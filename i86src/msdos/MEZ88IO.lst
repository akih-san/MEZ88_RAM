  277/ 140 : =>FALSE                    	IF      ANSI
  278/ 140 :                            
  279/ 140 :                            ;
  280/ 140 :                            ;ANSI Info and routines. ANSI driver implemented as a finite state automata
  281/ 140 :                            ;This ANSI driver translates the ANSI standard escape sequences into the
  282/ 140 :                            ; Zenith Escape sequences used on the Zenith(Heath) Z(H)-19 terminal.
  283/ 140 :                            ;This is not a full implementation of ANSI, but rather a minimal implementation
  284/ 140 :                            ; which implements all of the necessary ANSI functions.
  285/ 140 :                            ;
  286/ 140 :                            
  287/ 140 :                            ESC     EQU     1BH             ;Escape character used in this implementation.
  288/ 140 :                            STATE   DW      ST1             ;Current ANSI character state.
  289/ 140 :                            PRMPNT  DW      PARMS           ;Current parameter pointer.
  290/ 140 :                            PARMS   DB      0,0,0,0,0,0,0   ;Allow for up to eight parameters.
  291/ 140 :                            LASTPRM DB      0               ;With this being the eight one.
  292/ 140 :                            
  293/ 140 :                            CMDTABL DB      'A'             ;Cursor up.  "esc","[",#,"A"
  294/ 140 :                                    DW      CUU
  295/ 140 :                                    DB      'B'             ;Cursor down. "esc","[",#,"B"
  296/ 140 :                                    DW      CUD
  297/ 140 :                                    DB      'C'             ;Cursor forward. "esc","[",#,"C"
  298/ 140 :                                    DW      CUF
  299/ 140 :                                    DB      'D'             ;Cursor back. "esc","[",#,"D"
  300/ 140 :                                    DW      CUB
  301/ 140 :                                    DB      'H'             ;Direct cursor posit. "esc","[",x,y,"H"
  302/ 140 :                                    DW      CUP
  303/ 140 :                                    DB      'J'             ;Erase. "esc","[",code,"J"
  304/ 140 :                                    DW      ED
  305/ 140 :                                    DB      'K'             ;Erase in line. "esc","[",code,"K"
  306/ 140 :                                    DW      EL
  307/ 140 :                                    DB      'f'             ;Direct cursor posit. "esc","[",x,y,"f"
  308/ 140 :                                    DW      CUP
  309/ 140 :                                    DB      'm'             ;Special video mode. "esc","[",code,"m"
  310/ 140 :                                    DW      SGR
  311/ 140 :                                    DB      's'             ;Save cursor posit. "esc","[","s"
  312/ 140 :                                    DW      PSCP
  313/ 140 :                                    DB      'u'             ;Move cursor to saved. "esc","[","u"
  314/ 140 :                                    DW      PRCP
  315/ 140 :                                    DB      00              ;End of table.
  316/ 140 :                            
  317/ 140 :                            ;
  318/ 140 :                            ; ANSI console output driver.
  319/ 140 :                            ;
  320/ 140 :                            
  321/ 140 :                            CONOUT: MOV     DI,OFFSET STATE ;Retrieve current ansi state.
  322/ 140 :                                    JMP     [DI]            ;Jump to it.
  323/ 140 :                            
  324/ 140 :                            ;
  325/ 140 :                            ; State one (1).
  326/ 140 :                            ;   Looks for an Escape character.
  327/ 140 :                            ;
  328/ 140 :                            
  329/ 140 :                            ST1:    CMP     AL,ESC          ;See if this the first character is ESC.
  330/ 140 :                                    JNZ     OUTCHR          ;No, treat as regular character output.
  331/ 140 :                                    MOV     WORD PTR [DI],OFFSET ST2        ;Yes, setup state two.
  332/ 140 :                                    RET
  333/ 140 :                            
  334/ 140 :                            ;
  335/ 140 :                            ; State two (2).
  336/ 140 :                            ;   Looks for the "[" character.
  337/ 140 :                            ;
  338/ 140 :                            
  339/ 140 :                            ST2:    CMP     AL,'['          ;See if a valide state two.
  340/ 140 :                                    JNZ     OUTCHR          ;No, treat as regular charcter
  341/ 140 :                                    MOV     BX,OFFSET PARMS ;Yes, get parameter pointer.
  342/ 140 :                                    MOV     WORD PTR [PRMPNT],BX    ;Setup in pointer index.
  343/ 140 :                                    MOV     WORD PTR [BX],0 ;Clear first entry.
  344/ 140 :                                    MOV     WORD PTR [DI],OFFSET ST3;Setup for state three.
  345/ 140 :                                    RET
  346/ 140 :                            
  347/ 140 :                            ;
  348/ 140 :                            ; State three (3).
  349/ 140 :                            ;   Entered one or more times for parameter passing.
  350/ 140 :                            ;
  351/ 140 :                            
  352/ 140 :                            ST3:    CMP     AL,';'          ;Look for decimal # seperator.
  353/ 140 :                                    JNZ     ST3A            ;No check phase A.
  354/ 140 :                                    INC     WORD PTR [PRMPNT]       ;Yes, incr. pointer to next param.
  355/ 140 :                                    MOV     AX,OFFSET LASTPRM       ;Check for outside parameter list.
  356/ 140 :                                    CMP     [PRMPNT],AX
  357/ 140 :                                    JBE     RETST3          ;Yes, proceed with next parameter.
  358/ 140 :                                    MOV     [PRMPNT],AX     ;No, treat as extentsion to old.
  359/ 140 :                            RETST3: MOV     DI,[PRMPNT]     ;Setup for next parameter.
  360/ 140 :                                    MOV     BYTE PTR [DI],0 ;Pre-Initialize it to zero.
  361/ 140 :                                    RET
  362/ 140 :                            
  363/ 140 :                            ;
  364/ 140 :                            ; State three A (3A).
  365/ 140 :                            ;   Check for a ascii digit.
  366/ 140 :                            ;
  367/ 140 :                            
  368/ 140 :                            ST3A:   CMP     AL,'0'          ;Check for ASCII digit.
  369/ 140 :                                    JB      ST3B            ;No, check for seconday command character.
  370/ 140 :                                    CMP     AL,'9'          ;Still checking for ASCII digit.
  371/ 140 :                                    JA      ST3B            ;No, it must be a secondary.
  372/ 140 :                                    SUB     AL,'0'          ;Convert to binary.
  373/ 140 :                                    MOV     DI,[PRMPNT]     ;Get the current parameter pointer.
  374/ 140 :                                    XCHG    [DI],AL         ;Get existing #.
  375/ 140 :                                    MOV     AH,10           ;Scale by 10.
  376/ 140 :                                    MUL     AH
  377/ 140 :                                    ADD     [DI],AL         ;Add to new digit.
  378/ 140 :                                    RET
  379/ 140 :                            
  380/ 140 :                            ;
  381/ 140 :                            ; State three B (3B).
  382/ 140 :                            ;   Wasn't a ascii digit, so check for secondary command.
  383/ 140 :                            ;
  384/ 140 :                            
  385/ 140 :                            ST3B:   MOV     [DI],OFFSET ST1         ;Preset STATE to state 1 just in case.
  386/ 140 :                                    MOV     DI,OFFSET PARMS-1       ;Get pointer to start of parameters.
  387/ 140 :                                    MOV     [PRMPNT],DI             ;Save it in Parameter pointer.
  388/ 140 :                                    MOV     DI,OFFSET CMDTABL-3     ;Get start of Secondary command table.
  389/ 140 :                            
  390/ 140 :                            ST3B1:  ADD     DI,3            ;Update Command table pointer.
  391/ 140 :                                    CMP     BYTE PTR [DI],0 ;Check for end of table.
  392/ 140 :                                    JNZ     ST3B2           ;No, continue processing.
  393/ 140 :                                    JMP     OUTCHR          ;Yes, treat as regular character.
  394/ 140 :                            ST3B2:  CMP     AL,[DI]         ;Check for valid. command.
  395/ 140 :                                    JNZ     ST3B1           ;No, keep checking.
  396/ 140 :                                    JMP     [DI+1]          ;Yes, transfer to that secondary command.
  397/ 140 :                            
  398/ 140 :                            ;
  399/ 140 :                            ; Get binary parameter from storage and return a one if = 0
  400/ 140 :                            ;
  401/ 140 :                            
  402/ 140 :                            GETONE: CALL    GETPARM         ;Get parameter form list.
  403/ 140 :                                    OR      AL,AL           ;Verify for non-zero.
  404/ 140 :                                    JNZ     GETRET          ;Good, then return to caller.
  405/ 140 :                                    INC     AL              ;Bad, make it at least a one.
  406/ 140 :                            GETRET: CBW                     ;Sign extend AL.
  407/ 140 :                                    MOV     CX,AX           ;Copy of it to CX.
  408/ 140 :                                    RET
  409/ 140 :                            
  410/ 140 :                            GETPARM:INC     WORD PTR [PRMPNT]       ;Increment parameter pointer.
  411/ 140 :                            GOTPARM:MOV     DI,[PRMPNT]     ;Get parameter pointer.
  412/ 140 :                                    MOV     AL,[DI]         ;Get parameter value.
  413/ 140 :                                    RET
  414/ 140 :                            
  415/ 140 :                            ;
  416/ 140 :                            ; Send escape, character sequence.
  417/ 140 :                            ;
  418/ 140 :                            
  419/ 140 :                            OUTESC: MOV     AL,ESC          ;Send escape character.
  420/ 140 :                                    CALL    OUTCHR
  421/ 140 :                                    MOV     AL,BL           ;Send follow character.
  422/ 140 :                                    JMP     OUTCHR
  423/ 140 :                            
  424/ 140 :                            ;
  425/ 140 :                            ; Cursor Positioning routines.
  426/ 140 :                            ;
  427/ 140 :                            
  428/ 140 :                            CUU:    MOV     BL,'A'          ;Cursor up.
  429/ 140 :                                    JMP     SHORT CURPOS
  430/ 140 :                            CUD:    MOV     BL,'B'          ;Cursor down.
  431/ 140 :                                    JMP     SHORT CURPOS
  432/ 140 :                            CUF:    MOV     BL,'C'          ;Cursor forward.
  433/ 140 :                                    JMP     SHORT CURPOS
  434/ 140 :                            CUB:    MOV     BL,'D'          ;Cursor back.
  435/ 140 :                            
  436/ 140 :                            CURPOS: CALL    GETONE          ;Get number of positions to move into CX.
  437/ 140 :                            MOVCUR: CALL    OUTESC          ;Send escape, command characters.
  438/ 140 :                                    LOOP    MOVCUR          ;Keep moving until done.
  439/ 140 :                                    RET
  440/ 140 :                            
  441/ 140 :                            ;
  442/ 140 :                            ; Direct cursor positioning routine.
  443/ 140 :                            ;
  444/ 140 :                            
  445/ 140 :                            CUP:    CALL    GETONE          ;Get X position.
  446/ 140 :                                    MOV     DX,AX           ;Save in DX.
  447/ 140 :                                    CALL    GETONE          ;Get Y position.
  448/ 140 :                                    MOV     BL,'Y'
  449/ 140 :                                    CALL    OUTESC          ;Send escape, "Y" sequence.
  450/ 140 :                                    MOV     AL,DL
  451/ 140 :                                    ADD     AL,' '-1        ;Convert binary to Character.
  452/ 140 :                                    CALL    OUTCHR          ;Send X posit.
  453/ 140 :                                    MOV     AL,CL
  454/ 140 :                                    ADD     AL,' '-1        ;Convert binary to Character.
  455/ 140 :                                    JMP     OUTCHR          ;Send Y posit.
  456/ 140 :                            
  457/ 140 :                            ;
  458/ 140 :                            ; Erase all/part of screen.
  459/ 140 :                            ;
  460/ 140 :                            
  461/ 140 :                            ED:     CALL    GETPARM         ;Get trinary command type.
  462/ 140 :                                    MOV     BL,'b'
  463/ 140 :                                    DEC     AL              ;See if erase from begining of screen.
  464/ 140 :                                    JZ      ED1             ;Yes, perform ZDS function.
  465/ 140 :                                    MOV     BL,'E'
  466/ 140 :                                    DEC     AL              ;See if erase from end of screen.
  467/ 140 :                                    JZ      ED1             ;Yes, perform ZDS function.
  468/ 140 :                                    MOV     BL,'J'          ;Now we assume erase whole screen.
  469/ 140 :                            ED1:    JMP     OUTESC
  470/ 140 :                            
  471/ 140 :                            ;
  472/ 140 :                            ; Erase all/part of a line.
  473/ 140 :                            ;
  474/ 140 :                            
  475/ 140 :                            EL:     CALL    GETPARM         ;Get trinary command type.
  476/ 140 :                                    MOV     BL,'o'
  477/ 140 :                                    DEC     AL              ;See if erase from begining of line.
  478/ 140 :                                    JZ      EL1             ;Yes, perform ZDS function.
  479/ 140 :                                    MOV     BL,'l'
  480/ 140 :                                    DEC     AL              ;See if erase whole line.
  481/ 140 :                                    JZ      EL1             ;Yes, perform ZDS function.
  482/ 140 :                                    MOV     BL,'K'          ;Now we assume erase to end of line.
  483/ 140 :                            EL1:    JMP     OUTESC
  484/ 140 :                            
  485/ 140 :                            ;
  486/ 140 :                            ; Special video modes.
  487/ 140 :                            ;
  488/ 140 :                            
  489/ 140 :                            SGR:    CALL    GETPARM         ;Get trinary command type.
  490/ 140 :                                    MOV     BL,'p'
  491/ 140 :                                    CMP     AL,7            ;See if enter reverse video mode.
  492/ 140 :                                    JZ      SGR2            ;Yes, perform ZDS function.
  493/ 140 :                                    MOV     BL,'q'
  494/ 140 :                                    OR      AL,AL           ;See if exit reverse video mode.
  495/ 140 :                                    JNZ     SGR3            ;No, ignore.
  496/ 140 :                            SGR2:   CALL    OUTESC
  497/ 140 :                            SGR3:   RET
  498/ 140 :                            
  499/ 140 :                            ;
  500/ 140 :                            ; Save / restore cursor position.
  501/ 140 :                            ;
  502/ 140 :                            
  503/ 140 :                            PSCP:   MOV     BL,'j'          ;Set save cursor posit. mode.
  504/ 140 :                                    JMP     OUTESC
  505/ 140 :                            
  506/ 140 :                            PRCP:   MOV     BL,'k'          ;Restore last cursor save.
  507/ 140 :                                    JMP     OUTESC
  508/ 140 :                            
  509/ 140 : [277]                              ENDIF			; ANSI
