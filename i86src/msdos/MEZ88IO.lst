  102/  73 :                            ;-----------------------------------------------+
  103/  73 :                            ;     DWORD pointer to next device              | 1 word offset.
  104/  73 :                            ;         (-1,-1 if last device)                | 1 word segement.
  105/  73 :                            ;-----------------------------------------------+
  106/  73 :                            ;     Device attribute WORD                     ; 1 word.
  107/  73 :                            ;       Bit 15 = 1 for chacter devices.         ;
  108/  73 :                            ;                0 for Block devices.           ;
  109/  73 :                            ;                                               ;
  110/  73 :                            ;       Charcter devices. (Bit 15=1)            ;
  111/  73 :                            ;         Bit 0 = 1  current sti device.        ;
  112/  73 :                            ;         Bit 1 = 1  current sto device.        ;
  113/  73 :                            ;         Bit 2 = 1  current NUL device.        ;
  114/  73 :                            ;         Bit 3 = 1  current Clock device.      ;
  115/  73 :                            ;                                               ;
  116/  73 :                            ;         Bit 13 = 1 for non IBM machines.      ;
  117/  73 :                            ;                  0 for IBM machines only.     ;
  118/  73 :                            ;         Bit 14 = 1 IOCTL control bit.         ;
  119/  73 :                            ;-----------------------------------------------+
  120/  73 :                            ;     Device strategy pointer.                  ; 1 word offset.
